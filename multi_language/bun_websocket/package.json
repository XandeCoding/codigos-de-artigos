{
	"name": "bun_websocket",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"check": "biome check --write .",
		"watch": "bun run ./app/index.ts --watch",
		"start": "bun run ./app/index.ts",
		"compile": "bun build --production --compile --minify --sourcemap=inline --outfile=bun_websocket ./app/index.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"@types/bun": "^1.3.14",
		"biome": "^0.3.3"
	},
	"peerDependencies": {
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@logtape/logtape": "^1.3.10",
		"@logtape/otel": "^1.3.10",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/auto-instrumentations-node": "^0.67.3",
		"@opentelemetry/exporter-logs-otlp-grpc": "^0.218.0",
		"@opentelemetry/sdk-logs": "^0.208.0",
		"@opentelemetry/sdk-metrics": "^2.2.0",
		"@opentelemetry/sdk-node": "^0.208.0",
		"@opentelemetry/sdk-trace-node": "^2.7.1"
	}
}
